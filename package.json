{
    "name": "g4-test-wright",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "0.0.1",
    "icon": "resources.assets/icon.png",
    "engines": {
        "vscode": "^1.105.0"
    },
    "extensionDependencies": [
        "g4-api.g4-engine-client"
    ],
    "publisher": "g4-api",
    "repository": {
        "type": "git",
        "url": "https://github.com/g4-api/g4-test-wright-vscode-extension.git"
    },
    "categories": [
        "Testing",
        "Other"
    ],
    "keywords": [
        "g4",
        "automation",
        "test runner",
        "allure",
        "rpa"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onWebviewPanel:g4TestWright.panel"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "license": "Apache-2.0",
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "g4TestWright.sidePanelIcon": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute path to an SVG file to show as the Test Wright side-panel (activity bar) icon, its panel tab icon, and its page header icon, for example `C:/branding/test-wright.svg` or `~/branding/test-wright.svg`. Draw it on a 24 by 24 grid in one color (`currentColor`); at most 256 KB. Takes precedence over the icon the Hub branding publishes. VS Code reads the activity bar icon at startup, so a change shows there from the next start. Leave empty for the Hub icon or the built-in icon."
                }
            }
        },
        "commands": [
            {
                "command": "TestWright.Show",
                "category": "%command.TestWright.Show.category%",
                "title": "Open Test Wright",
                "icon": "$(checklist)"
            },
            {
                "command": "TestWright.OpenNew",
                "category": "%command.TestWright.OpenNew.category%",
                "title": "Open New Test Wright Tab",
                "icon": "$(add)"
            },
            {
                "command": "TestWright.AddPracticeBots",
                "category": "%command.TestWright.AddPracticeBots.category%",
                "title": "Add Practice Bots"
            },
            {
                "command": "TestWright.ShowComponentGallery",
                "category": "%command.TestWright.ShowComponentGallery.category%",
                "title": "Show Component Gallery (Development)"
            },
            {
                "command": "TestWright.ShowRunReport",
                "category": "%command.TestWright.ShowRunReport.category%",
                "title": "Open Run Report"
            },
            {
                "command": "TestWright.ConvertRunToAllure",
                "category": "%command.TestWright.ConvertRunToAllure.category%",
                "title": "Convert Run to Allure Results"
            },
            {
                "command": "TestWright.RefreshDocuments",
                "category": "%command.TestWright.RefreshDocuments.category%",
                "title": "Refresh Documentation",
                "icon": "$(refresh)"
            }
        ],
        "views": {
            "g4TestWrightContainer": [
                {
                    "type": "tree",
                    "id": "g4TestWrightLauncher",
                    "name": "Test Wright",
                    "icon": "resources.assets/g4-test-wright-mark.svg"
                },
                {
                    "type": "tree",
                    "id": "g4TestWrightDocuments",
                    "name": "Documentation"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "g4TestWrightLauncher",
                "contents": "%viewsWelcome.g4TestWrightLauncher.0.contents%"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "g4TestWrightContainer",
                    "title": "%viewsContainer.g4TestWrightContainer.title%",
                    "icon": "resources.assets/g4-test-wright-mark.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "TestWright.RefreshDocuments",
                    "group": "navigation",
                    "when": "view == g4TestWrightDocuments"
                }
            ],
            "explorer/context": [
                {
                    "command": "TestWright.ShowRunReport",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceFilename == run.json"
                },
                {
                    "command": "TestWright.ConvertRunToAllure",
                    "group": "navigation@2",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceFilename == run.json"
                }
            ],
            "commandPalette": [
                {
                    "command": "TestWright.ShowComponentGallery",
                    "when": "g4TestWright.isDevelopment"
                },
                {
                    "command": "TestWright.ShowRunReport",
                    "when": "false"
                },
                {
                    "command": "TestWright.ConvertRunToAllure",
                    "when": "false"
                },
                {
                    "command": "TestWright.RefreshDocuments",
                    "when": "false"
                }
            ]
        },
        "grammars": [
            {
                "language": "g4log",
                "scopeName": "source.g4.log",
                "path": "./languages/g4-log-tm-language.json"
            }
        ],
        "languages": [
            {
                "id": "g4log",
                "aliases": [
                    "G4Log",
                    "g4Log"
                ],
                "extensions": []
            }
        ]
    },
    "readme": "README.md",
    "licenses": [
        {
            "path": "LICENSE",
            "type": "Apache-2.0"
        }
    ],
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "lint": "eslint src"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "eslint": "^9.25.1",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "webpack": "^5.99.7",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "allure": "3.20.1"
    }
}
